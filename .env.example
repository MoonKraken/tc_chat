# inprocess loads a model inside this process (mistral.rs).
# ollama sends chat requests to a running Ollama daemon (rig).
PROVIDER=ollama

# Ollama base URL. Ignored for inprocess. Trailing slashes are stripped.
PROVIDER_BASE=http://127.0.0.1:11434

# Optional bearer token for a proxied Ollama, or a Hugging Face token when
# PROVIDER=inprocess and the model is gated.
# API_KEY=

# inprocess: Hugging Face id, a local model directory, or a .gguf file path.
# ollama: the model tag (`ollama list`).
MODEL=llama3.2

# GGUF filename when MODEL is a directory or a Hugging Face repo that contains it.
# MODEL_FILE=model.gguf

# In-process quantization for a full model: 2, 3, 4, 5, 6, or 8.
# Leave unset for published weights. Do not set this for a GGUF file or for Ollama.
# ISQ=4

# SYSTEM_PROMPT=You are a helpful assistant.
# TEMPERATURE=0.7
# MAX_TOKENS=1024

# HOST=127.0.0.1
# PORT=3000
